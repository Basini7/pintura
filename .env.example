# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - PROPOSTA DO PINTOR
# ==============================================================================

# Porta do servidor (padrão 3000)
PORT=3000

# Conexão com o Banco de Dados PostgreSQL no Supabase
# No painel do Supabase: Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo de validação do Webhook da Kiwify (opcional, para segurança extra)
KIWIFY_WEBHOOK_SECRET=

# Domínios permitidos no CORS (separados por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://propostadopintor.com.br
